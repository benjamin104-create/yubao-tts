---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<html lang="zh-Hant">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="container">
      <section class="hero">
        <p class="eyebrow">Jaminepa.com</p>
        <h1>把時間，<br />慢慢寫成一間<span class="em">書房</span>。</h1>
        <p>
          你好，我是潔米爸。這裡放著寫給女兒語寶的成長紀錄與育兒思考、
          語言自學的心得、走過的地方與世界的故事；也收藏我自學紫微斗數的筆記與漫畫。
        </p>
        <span class="vertical" aria-hidden="true">語寶 · 紫微筆記</span>
      </section>

      <div class="category-grid">
        <a class="category-card yubao" href="/yubao/">
          <span class="icon">🌱</span>
          <h2>語寶</h2>
          <p>{CATEGORIES.yubao.description}</p>
          <span class="cta">看看文章 →</span>
        </a>
        <a class="category-card ziwei" href="/ziwei/">
          <span class="icon">🔮</span>
          <h2>紫微筆記</h2>
          <p>{CATEGORIES.ziwei.description}</p>
          <span class="cta">看看文章 →</span>
        </a>
      </div>

      <h2 class="section-title">最新文章</h2>
      {posts.map((post) => <PostCard id={post.id} {...post.data} />)}
    </main>
    <Footer />
  </body>
</html>
