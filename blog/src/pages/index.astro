---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import NineGrid from '../components/NineGrid.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<html lang="zh-Hant">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="page-home">
    <Header />
    <main>
      <section class="grid-hero container">
        <p class="eyebrow">洛書九宮 · 命盤即腦內</p>
        <h1>一個人的心，<br />是一張<span>九宮格</span></h1>
        <p class="hero-lead">
          中心是本體我（I），六格是意識的六種顏色（E），兩格通往語寶與卡牌世界。
          命盤不是命運判決，而是一張練習理解自己的地圖。
        </p>
        <div class="hero-orbit" aria-hidden="true">
          <span></span>
          <span></span>
        </div>
      </section>

      <div class="container">
        <NineGrid />

        <section class="latest-section" aria-labelledby="latest-title">
          <div class="section-intro compact">
            <p class="eyebrow">FROM THE STUDY</p>
            <h2 id="latest-title">最新文章</h2>
          </div>
          <div class="post-list">
            {posts.map((post) => <PostCard id={post.id} {...post.data} />)}
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
