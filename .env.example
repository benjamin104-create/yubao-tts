# Windsor.ai → Instagram Reels 審計　環境變數範本
# 複製成 .env 並填入你的值；.env 不會被 git 追蹤。
#
#   cp .env.example .env
#   然後編輯 .env，再： set -a; source .env; set +a

# 必填：Windsor.ai 的 API key（後台 "Get data" 取得）
WINDSOR_API_KEY=

# 可選：來源連接器。預設 instagram（Windsor IG 連接器的 API 路徑名）。
# WINDSOR_CONNECTOR=instagram

# 可選：覆寫要抓的欄位（逗號分隔）。不填用程式內建預設。
# WINDSOR_FIELDS=date,media_id,media_caption,media_reel_video_views,media_reach,media_like_count,media_comments_count,media_shares,media_saved

# 可選：API base，一般不用改。
# WINDSOR_BASE=https://connectors.windsor.ai
