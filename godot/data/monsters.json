  "encounter_bands": {
    "_comment": "每層的出現表 = 所有 floor_range 涵蓋該層的怪物，權重依距離主場層段線性衰減：weight_final = spawn_weight * falloff(F)。falloff 在 floor_range 中央為 1.0，兩端邊界為 0.4，超出範圍為 0 —— 讓玩家有 2~3 層的緩衝期熟悉新怪。",
    "falloff_edge_ratio": 0.4,
    "monster_house_multiplier": { "_comment": "怪物之家使用同一張表，但 spawn_weight 對 WANDERER 減半、CHASER 加倍 —— 確保進門的瞬間是壓迫感而非鬧劇。", "CHASER": 2.0, "WANDERER": 0.5, "RANGED": 1.0 }
  }
