{
  "schema_version": "0.2",
  "_comment": "怪物主資料表。ai_profile 決定行為模式，數值欄位餵入 §傷害公式。decision_priority 由上而下求值，第一個成立的分支即為本回合 Intent（P4 決策階段，見 GDD §1.3）。",

  "ai_profiles": {
    "CHASER": {
      "name": "直線追逐型",
      "design_role": "地牢的基礎壓力。完全可預測 —— 玩家可以精確計算幾回合後被追上，因此『拉到走廊 1v1』『繞柱子』等走位戰術對牠成立。難度來自數值，不是行為。",
      "priority_class": 3,
      "params": {
        "detect_mode": "ROOM_WIDE_OR_SIGHT",
        "_detect_comment": "與玩家同房間 → 必定發現；走廊中 → 需在 sight 格內且視線無阻擋",
        "memory_turns": 8,
        "_memory_comment": "失去玩家視野後，仍朝 last_known_pos 前進 memory_turns 回合，之後轉為巡邏",
        "aggro_on_damage": true,
        "flee_hp_ratio": 0.0,
        "prefers_diagonal": true
      },
      "decision_priority": [
        { "cond": "status.has(SLEEP) or status.has(PARALYZE)", "intent": "WAIT" },
        { "cond": "status.has(CONFUSED)", "intent": "MOVE(random_dir)" },
        { "cond": "is_adjacent(player) and not corner_blocked(self, player)", "intent": "ATTACK(player)" },
        { "cond": "can_see(player)", "intent": "MOVE(step_toward(player)); memory = player.pos; memory_left = memory_turns" },
        { "cond": "memory_left > 0", "intent": "MOVE(step_toward(memory)); memory_left -= 1" },
        { "cond": "true", "intent": "MOVE(patrol_dir)" }
      ],
      "counter_strategy": ["走廊 1v1", "擊退之杖", "位移之杖", "睡眠"]
    },

    "WANDERER": {
      "name": "隨機遊蕩型",
      "design_role": "地牢的環境噪音，也是『可以繞過去』的選項。不主動追擊 → 玩家可以選擇不打；但受擊後會轉為追擊，讓『打了一半就跑』要付代價。牠的存在讓『避戰』成為一種正當策略。",
      "priority_class": 5,
      "params": {
        "detect_mode": "ADJACENT_ONLY",
        "wander_bias": 0.6,
        "_wander_comment": "有 wander_bias 機率沿用上一回合方向（避免原地抖動的視覺噪音），否則重擲 8 方向",
        "aggro_on_damage": true,
        "aggro_turns": 15,
        "_aggro_comment": "受擊後暫時套用 CHASER 的 decision_priority，計時歸零後回復遊蕩",
        "memory_turns": 3,
        "flee_hp_ratio": 0.0
      },
      "decision_priority": [
        { "cond": "status.has(SLEEP) or status.has(PARALYZE)", "intent": "WAIT" },
        { "cond": "aggro_left > 0", "intent": "DELEGATE(CHASER); aggro_left -= 1" },
        { "cond": "is_adjacent(player) and not corner_blocked(self, player)", "intent": "ATTACK(player)" },
        { "cond": "rand() < wander_bias and can_walk(last_dir)", "intent": "MOVE(last_dir)" },
        { "cond": "true", "intent": "MOVE(random_walkable_dir); last_dir = chosen" }
      ],
      "counter_strategy": ["直接繞過", "先手秒殺（避免進入 aggro）", "引誘之杖拉離動線"]
    },

    "RANGED": {
      "name": "遠程攻擊型",
      "design_role": "走廊戰術的剋星。CHASER 讓走廊變安全，RANGED 讓走廊變成射擊場 —— 沒有牠，全遊戲的戰鬥會塌縮成同一招。牠強迫玩家處理『距離』這個維度：貼上去、切斷視線、或用杖解決。",
      "priority_class": 1,
      "_priority_comment": "priority_class 最小 → 在 P5 執行階段最先行動，確保『先射擊再由近戰怪補位』的威脅感成立",
      "params": {
        "detect_mode": "LINE_OF_SIGHT",
        "keep_distance": [3, 8],
        "_distance_comment": "距離 < 3 → 後退（kiting）；3~8 且對齊 → 射擊；> 8 → 接近",
        "fire_alignment": ["ORTHOGONAL", "DIAGONAL"],
        "_alignment_comment": "僅在同列/同行/正對角線且路徑無阻擋時可射擊。這讓玩家能靠『站在非對齊格』主動躲避 —— 是可推理的規避手段，不是骰運",
        "cooldown_turns": 2,
        "memory_turns": 5,
        "aggro_on_damage": true,
        "flee_hp_ratio": 0.25,
        "_flee_comment": "HP 低於 25% 時逃離玩家，逼玩家追擊或放生"
      },
      "decision_priority": [
        { "cond": "status.has(SLEEP) or status.has(PARALYZE)", "intent": "WAIT" },
        { "cond": "status.has(ABILITY_SEALED)", "intent": "DELEGATE(CHASER)", "_comment": "被封魔後退化為普通追擊怪" },
        { "cond": "hp / max_hp < flee_hp_ratio", "intent": "MOVE(step_away_from(player))" },
        { "cond": "is_adjacent(player)", "intent": "ATTACK(player)", "_comment": "貼身時只能近戰，且近戰數值弱 → 貼上去就是正解" },
        { "cond": "dist(player) < keep_distance[0]", "intent": "MOVE(step_away_from(player))" },
        { "cond": "cooldown_left > 0", "intent": "MOVE(hold_or_reposition); cooldown_left -= 1" },
        { "cond": "is_aligned(player) and line_clear(player) and dist <= keep_distance[1]", "intent": "RANGED_ATTACK(player); cooldown_left = cooldown_turns" },
        { "cond": "can_see(player)", "intent": "MOVE(step_to_align_with(player))" },
        { "cond": "memory_left > 0", "intent": "MOVE(step_toward(memory)); memory_left -= 1" },
        { "cond": "true", "intent": "WAIT" }
      ],
      "counter_strategy": ["貼身近戰", "切斷直線（站到非對齊格）", "封魔之杖", "鏡之盾反射", "替身之杖直接換位"]
    }
  },

